[Unit]
Description=Bike Computer
After=network.target sound.target gpsd.service bluetooth.service
Wants=gpsd.service bluetooth.service

[Service]
Type=simple
User=caden
Group=caden

WorkingDirectory=/opt/bikecomputer

# Strava client secret — set this before enabling the service:
#   sudo systemctl edit bikecomputer
# and add:
#   [Service]
#   Environment="STRAVA_CLIENT_SECRET=your_secret_here"
EnvironmentFile=-/etc/bikecomputer/env

# mpv and librespot talk to PipeWire over the user session bus, which
# only exists if the user has a running session bus address.
Environment="XDG_RUNTIME_DIR=/run/user/1000"

ExecStart=/opt/bikecomputer/venv/bin/python -m bikecomputer.app

Restart=always
RestartSec=5

# Allow GPIO, SPI, audio and Bluetooth access
SupplementaryGroups=gpio spi audio bluetooth

# Write access for ride files, settings, music and the mpv IPC socket
ReadWritePaths=/var/bikecomputer /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bikecomputer

[Install]
WantedBy=multi-user.target
