[Unit]
Description=Bike Computer
After=network.target gpsd.service
Wants=gpsd.service

[Service]
Type=simple
User=caden
Group=caden

WorkingDirectory=/opt/bikecomputer

# Strava client secret — set this before enabling the service:
#   sudo systemctl edit bikecomputer
# and add:
#   [Service]
#   Environment="STRAVA_CLIENT_SECRET=your_secret_here"
EnvironmentFile=-/etc/bikecomputer/env

ExecStart=/opt/bikecomputer/venv/bin/python -m bikecomputer.app

Restart=always
RestartSec=5

# Allow GPIO and SPI access
SupplementaryGroups=gpio spi

# Write access for ride files
ReadWritePaths=/var/bikecomputer

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bikecomputer

[Install]
WantedBy=multi-user.target
